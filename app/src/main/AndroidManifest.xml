<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET: Currency Converter fetches live rates from
         open.er-api.com, and Flight Tracker (Phase 2) queries
         api.aviationstack.com — both exactly like the source HTML app.
         No other permission is needed by any tool so far. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.1.0: haptic feedback (a single light 10ms tick mirroring the
         web editions' navigator.vibrate(10) at the beep trigger points),
         gated by the toolbox_haptics Settings toggle (default on). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Legacy (API <= 28) "download" of PDF Tool outputs / exports to the
         public Downloads folder, mirroring the web app's downloadBlob.
         On API 29+ MediaStore is used and needs no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <application
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToolboxNative"
        tools:targetApi="35">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ToolboxNative">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- FileProvider for share-sheet delivery of exports / PDF outputs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
